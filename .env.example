# Скопировать в .env.local. Файл .env.local в гит не едет.

# Секрет владельца: значение куки, по которой сайт узнаёт владельца в боевой сборке.
# Нужен только тому, кто запускает боевую сборку у себя (npm run build && npm start):
# при обычном npm run dev владельцем считается любой посетитель.
# Сгенерировать: openssl rand -hex 24. На сервере секрет свой, отдельный — он
# генерируется прямо там, в /etc/kinobase.env, и с этим значением не связан.
OWNER_TOKEN=

# Путь к базе SQLite. По умолчанию data/kinobaza.db; для живых проверок в браузере —
# отдельная база, например DB_PATH=/tmp/kinobaza-test.db.
# DB_PATH=data/kinobaza.db

# Ключи поисковых сервисов для скиллов наполнения. Все необязательны: без них агент
# ищет встроенными инструментами. Какие есть — записано в research/SEARCH-PROFILE.md.
EXA_API_KEY=
TABSTACK_API_KEY=
PARALLEL_API_KEY=
