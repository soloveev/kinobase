# Образец /etc/kinobase.env — файла с секретом владельца на сервере.
# Служба читает его через EnvironmentFile= (см. ops/kinobase.service).
#
# Формат — строки KEY=VALUE, без «export» и без кавычек: systemd разбирает файл
# сам, кавычки он снимет и включит в значение то, что осталось.
#
# Установка и права: файл читает только root и системный пользователь службы.
#   install -m 600 -o root -g root /dev/null /etc/kinobase.env
#   printf 'OWNER_TOKEN=%s\n' "$(openssl rand -hex 24)" > /etc/kinobase.env
#   systemctl restart kinobase
#
# С кодом этот файл не едет: deploy.sh исключает «.env*» из переноса намеренно.

# Значение куки, по которой боевой сайт узнаёт владельца.
#
# Сгенерировать:  openssl rand -hex 24
#
# Это то же самое значение, что в локальном .env.local: маршрут /owner/login кладёт
# в куку ровно его, а сайт сверяет куку с этой переменной. Разойдутся — владелец
# на сервере перестанет быть владельцем и увидит сайт глазами гостя.
# Пустое или отсутствующее значение закрывает вход всегда: опечатка в конфигурации
# должна запирать дверь, а не открывать.
#
# Локально переменная не обязательна: вне боевой сборки владельцем считается любой,
# кто открыл сайт на своей машине.
OWNER_TOKEN=
