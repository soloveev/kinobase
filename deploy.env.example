# Куда выкатывать: скопировать в deploy.env и заполнить. deploy.env в гит не едет.
SSH_HOST=            # ssh-алиас или user@host сервера
REMOTE_DIR=/var/www/kinobase          # куда едет код
REMOTE_DB=/var/lib/kinobase/kinobaza.db   # база на сервере — источник правды, скрипт её не трогает
BACKUPS=/var/backups/kinobase         # куда снимается копия базы перед перезапуском
SERVICE=kinobase                      # имя systemd-службы (ops/kinobase.service)
DOMAIN=                               # домен сайта, по нему проверяется ответ после выкатки
SERVER_IP=                            # IP сервера для проверки снаружи (curl --resolve)
DEPLOY_USER=kinobase                  # пользователь службы; ему отдаётся код после сборки (ops/kinobase.service)
APP_PORT=3001                         # локальный порт next start; тот же в ops/kinobase.service и ops/nginx-kinobase.conf
