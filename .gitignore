# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# образец настроек — единственный env-файл, который едет в гит
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# database
/data/
*.db
*.db-journal
*.sqlite

# impeccable local state
.impeccable/

# Архив исследований: полные тексты источников по каждому фильму (research/<фильм>/),
# по несколько мегабайт на тайтл. Нужен для перепроверки досье, но не для истории кода.
# Версионируются только файлы правил в корне research/ и журналы заходов.
/research/*/
!/research/runs/
!/research/new-titles/

# Адрес своего сервера и пути на нём
deploy.env

# Питоновский кэш скриптов
__pycache__/
